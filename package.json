{
  "name": "ghostwriter",
  "version": "0.1.0",
  "description": "A small document editor that people and their AI assistants edit together: a website, a server, and an MCP App for Claude and ChatGPT.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
