    "evals:selftest": "node evals/run.js --selftest"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
